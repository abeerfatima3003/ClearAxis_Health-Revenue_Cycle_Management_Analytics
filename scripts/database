/*
==========================================================
Creating Database
==========================================================
Script Purpose:
This script creates a new database named 'ClearAxisRCM' after checking if it already exists.
If the database already exists, it is dropped and recreated. 

WARNING:
Running this script will drop the entire 'ClearAxisRCM' database if it exists. 
All data in the database will be permanently deleted.
Proceed with caution and ensure you have proper backups before running this script.
*/

-- This database is used to create other databases
USE master;
GO

-- Drop and recreate the 'ClearAxisRCM' database
IF EXISTS (SELECT 1 FROM sys.databases WHERE name = 'ClearAxisRCM')
BEGIN
	ALTER DATABASE ClearAxisRCM SET SINGLE_USER WITH ROLLBACK IMMEDIATE;
	DROP DATABASE ClearAxisRCM;
END;
GO

-- Creating a new database 'ClearAxisRCM'
CREATE DATABASE ClearAxisRCM;
GO

USE ClearAxisRCM;
GO
